# Example Terraform variables for pg_cyan Azure deployment
# Copy to terraform.tfvars and adjust for your environment

resource_group_name = "pg-cyan-migration-rg"
azure_region        = "westus2"
vm_name             = "pg-cyan-worker-01"
vm_size             = "Standard_B2s"  # 2 vCPU, 4 GB RAM (scale later as needed)
admin_username      = "azureuser"

# REQUIRED: Generate SSH key with: ssh-keygen -t rsa -b 4096 -f ~/.ssh/pg_cyan_rsa
ssh_public_key_path = "~/.ssh/pg_cyan_rsa.pub"

# PostgreSQL version: choose from 12, 13, 14, 15, 16
postgresql_version = "15"

# Network configuration
vnet_address_space       = ["10.0.0.0/16"]
subnet_address_prefixes  = ["10.0.1.0/24"]

# Security: Restrict SSH to specific IPs (e.g., your office or VPN)
# For testing: allowed_ssh_cidr = "*" (WARNING: not production-safe)
allowed_ssh_cidr    = "*"

# PostgreSQL access restricted to VNet by default
allowed_postgres_cidr = "10.0.0.0/16"

environment_tags = {
  project     = "pg_cyan"
  team        = "database-migration"
  environment = "staging"
}
